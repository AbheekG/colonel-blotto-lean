import Blotto.GeneralPaperAdaptivePowerRange
import Blotto.PRGRealRAMExecution

/-! Join the adaptive state to the retained local-array/power/prefix query
pipeline. The delta histories below are generated by the actual prior states;
neither occurrence callbacks nor prefix arrays are independently supplied.
-/
namespace Blotto.GeneralPaperAdaptivePrefixJoin
open GeneralPaperEpochFieldState GeneralPaperEpochDeltas GeneralPaperAdaptiveEpoch
open GeneralPaperAdaptiveEpochHistory GeneralPaperEpochDeltaSemantics
set_option autoImplicit false
set_option maxHeartbeats 3500000

def deltaAt {n k : ℕ} (prepared : GeneralPaperPreparedPowers.Prepared) (select : Selector n k)
    (plans : FixedArrayTable n (GeneralPaperEpochFieldPlan.Plan k)) (time : ℕ) (j : Fin n) :
    Deltas (fieldAt prepared select (initial plans) time j) :=
  (generate (fieldAt prepared select (initial plans) time j) (snapshotAt prepared select (initial plans) time j)
    (choiceAt prepared select (initial plans) time j)).1

theorem p_delta {n k : ℕ} (prepared : GeneralPaperPreparedPowers.Prepared) (select : Selector n k)
    (plans : FixedArrayTable n (GeneralPaperEpochFieldPlan.Plan k)) (time : ℕ) (j : Fin n)
    (r : Fin (GeneralPaperSourceParameters.prepare k).summarySize) :
    (deltaAt prepared select plans time j).pOccurrences.read r=
      pIncrement (fieldAt prepared select (initial plans) time j) (snapshotAt prepared select (initial plans) time j) ((plans.read j).pSummary.read r) := by
  unfold deltaAt
  rw [p_occurrence,show (fieldAt prepared select (initial plans) time j).plan=plans.read j from
    GeneralPaperAdaptiveEpochBounds.initial_plan prepared select plans time j]

