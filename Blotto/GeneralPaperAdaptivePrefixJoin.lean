theorem p_array {n k : ℕ} (prepared : GeneralPaperPreparedPowers.Prepared) (select : Selector n k)
    (plans : FixedArrayTable n (GeneralPaperEpochFieldPlan.Plan k)) (count : ℕ) (j : Fin n) :
    (fieldAt prepared select (initial plans) count j).pOccurrences=
      (GeneralPaperEpochLevelArray.execute (fun t => (deltaAt prepared select plans t j).pOccurrences) count).1 := by
  apply PRGExactRealRAMContract.table_ext
  intro r
  rw [p_levels,GeneralPaperEpochLevelArray.execute_read]
  apply GeneralPaperEpochLevelArray.levels_agree
  intro t _
  exact (p_delta prepared select plans t j r).symm

