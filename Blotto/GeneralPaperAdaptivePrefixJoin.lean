theorem p_prefix {n k : ℕ} (prepared : GeneralPaperPreparedPowers.Prepared) (select : Selector n k)
    (plans : FixedArrayTable n (GeneralPaperEpochFieldPlan.Plan k)) (count : ℕ) (j : Fin n) :
    (snapshotAt prepared select (initial plans) count j).p.cdf=
      GeneralPaperEpochCachedQuery.prefixes prepared (fun t => (deltaAt prepared select plans t j).pOccurrences) count := by
  change GeneralPaperEpochPrefixArray.build (GeneralPaperEpochPowerQueries.buildNumerators prepared
    (fieldAt prepared select (initial plans) count j).pOccurrences)=_
  rw [p_array]
  rfl

